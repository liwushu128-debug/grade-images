{
  "schema_version": "1.3",
  "intent": "Sample-informed vivid documentary color with explicit, bounded output sharpening; preserve source detail and add no repair, denoise, deblur, clarity, dehaze, grain, dust, or synthetic texture",
  "strategy": {"intensity": "standard", "style": "custom", "selection": "explicit"},
  "preservation": {
    "mode": "strict",
    "allow_geometry_changes": false,
    "allow_texture_changes": true,
    "allow_generative_changes": false
  },
  "correction": {
    "exposure_ev": 0.0,
    "white_balance": {"rgb_gains": [1.0, 1.0, 1.0]},
    "black_point": 0.003,
    "white_point": 1.04,
    "highlight_rolloff": 0.24
  },
  "look": {
    "tone_curve": {"strength": 0.54},
    "cdl": {
      "slope": [1.025, 1.01, 0.985],
      "offset": [0.0, 0.0, 0.0],
      "power": [1.04, 1.025, 1.045],
      "saturation": 1.0
    },
    "vibrance": 0.5,
    "split_tone": {
      "shadows": [0.25, 0.47, 0.43],
      "highlights": [0.78, 0.59, 0.3],
      "balance": 0.05,
      "strength": 0.105
    }
  },
  "texture": {
    "permission": "source-derived-only",
    "selection": "explicit-user",
    "mode": "refine",
    "output_sharpen": {
      "enabled": true,
      "amount": 0.10,
      "radius_pixels": 0.75,
      "threshold": 0.014,
      "protect_skin": true,
      "protect_noise": true
    }
  },
  "protection": {"skin": {"enabled": true, "strength": 0.72}},
  "output": {"format": "png", "quality": 95, "profile": "sRGB", "preserve_metadata": true}
}
